# ============================================================
# parkpick 환경 변수 예시 (.env.example)
# 실제 값은 .env(로컬) / Render·Netlify 대시보드(배포)에만 등록합니다.
# ============================================================

# ---------- [백엔드] ----------
# FastAPI 실행 포트
PORT=8000
# JWT 서명 키 (필수, 강력한 랜덤 문자열)
JWT_SECRET_KEY=change-me-to-a-long-random-string
# JWT 만료(분)
JWT_EXPIRE_MINUTES=120
# 실제 관리자 인증용 보안 키 (관리자 로그인 시 입력)
ADMIN_SECRET_KEY=change-me-admin-secret
# 테스트 계정 비밀번호 (데모용)
TEST_USER_PASSWORD=User1234!
TEST_ADMIN_PASSWORD=Admin1234!
# DB 접속 문자열 (TiDB/MySQL/SQLite). 미설정 시 인메모리 Mock 사용
DATABASE_URL=sqlite:///./parkpick.db
# 프런트엔드 도메인 (CORS 허용 출처, 쉼표 구분)
CORS_ORIGINS=http://localhost:5173,https://cctv-drive.netlify.app,https://cctv-drive.onrender.com
# Google Gemini API 키 (AI 운영 리포트 자동 생성). 미설정 시 규칙 기반 리포트 생성
GEMINI_API_KEY=
# 공공데이터포털 주차장 API 키
PUBLIC_DATA_API_KEY=

# ---------- [AI 모델] ----------
# YOLO 가중치 경로 (대용량 → .gitignore, 클라우드 버킷 관리)
YOLO_WEIGHTS=ai/weights/best.pt
# 탐지 신뢰도 임계값
DETECT_CONFIDENCE=0.45
# OCR 엔진 (easyocr | paddleocr)
OCR_ENGINE=easyocr

# ---------- [프런트엔드] ----------
# 백엔드 API 주소 (비어 있으면 Mock 데이터로 동작하는 데모 모드)
VITE_API_URL=
# WebSocket 주소 (비어 있으면 VITE_API_URL에서 유도)
VITE_WS_URL=
